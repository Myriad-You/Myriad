# =============================================================================
# Myriad Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your configuration values
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://myriad:password@localhost:5432/myriad

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Host address the server will bind to
# Use 0.0.0.0 to accept connections from any network interface
# Use 127.0.0.1 for local-only access
SERVER_HOST=127.0.0.1

# Port the server will listen on
SERVER_PORT=1103

# Logging Configuration
# Levels: error, warn, info, debug, trace
# Format: level,crate_name=level
RUST_LOG=info,myriad_backend=debug

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Path to the built frontend assets directory
# This should point to your compiled Astro/React frontend
FRONTEND_DIST_PATH=../frontend/dist

# -----------------------------------------------------------------------------
# Security Configuration (Required - MUST CHANGE IN PRODUCTION)
# -----------------------------------------------------------------------------
# JWT Secret Key for token signing and verification
# SECURITY CRITICAL: Must be at least 32 characters!
# Generate with: openssl rand -base64 64
# Example: JWT_SECRET=kJ8mN2pQ5rT7vX9zB3cF6hK8mP0qS4tW6yA9bD2eG5jH7kN9pR2sU5vY8zA1cE4g
JWT_SECRET=

# Setup passphrase for first-owner claim when orchestration already wrote DATABASE_URL.
# Leave empty for wizard-only DB setup. deploy.sh fills it on Docker installs.
# MYRIAD_SETUP_SECRET=

# CORS Configuration
# Comma-separated list of allowed origins for CORS requests
# Add your frontend URL(s) here
CORS_ORIGINS=http://localhost:1102,http://localhost:1103

# -----------------------------------------------------------------------------
# Optional Base URLs
# -----------------------------------------------------------------------------
# Public backend/base URL used for callbacks, WebFinger, and ActivityPub Actor URLs.
# For federation, set this to the public HTTPS origin that other instances can reach.
# BASE_URL=https://yourdomain.com

# Frontend URL (used for redirects and profile links)
# FRONTEND_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# Updater Proxy (Optional)
# -----------------------------------------------------------------------------
# Local development does not start the updater service by default. The dev
# scripts can start an isolated updater harness and inject these values for you:
#   ./scripts/dev.sh start all-updater
# Leave these unset unless you run updater separately or test the production
# compose update flow.
# MYRIAD_UPDATER_URL=http://127.0.0.1:1101
# UPDATE_TOKEN=

# -----------------------------------------------------------------------------
# Official Tapp store install stats (optional)
# -----------------------------------------------------------------------------
# Store install stats — no secrets. Local OFF; production auto-on.
# 1 count per instance / app / UTC day.
#   TAPP_STORE_STATS_ENABLED=false   # local default via dev.sh
#   TAPP_STORE_STATS_URL=https://stats.store.myriad.you
#   BASE_URL=https://your.domain     # production instance identity
# Optional: TAPP_STORE_INSTANCE_ID=my-site-name

# =============================================================================
# Note: All other application configurations (AI keys, Platform tokens, UI settings)
# are now managed via the database and can be configured through the web interface
# at /setup or /settings.
# =============================================================================
