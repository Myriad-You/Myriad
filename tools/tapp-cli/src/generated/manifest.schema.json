        },
        "modelTier": {
          "$ref": "#/$defs/TappAiModelTier"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/TappAiOperation"
          },
          "type": "array"
        },
        "outputFormats": {
          "items": {
            "$ref": "#/$defs/TappAiOutputFormat"
          },
          "type": "array"
        },
        "protocolVersion": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "protocolVersion",
        "operations",
        "modelTier",
        "outputFormats"
      ],
      "type": "object"
    },
    "TappAiModelTier": {
      "enum": [
        "standard",
        "pro"
      ],
      "type": "string"
    },
    "TappAiOperation": {
      "enum": [
        "generate",
        "analyze",
        "chat",
        "image"
      ],
      "type": "string"
    },
    "TappAiOutputFormat": {
      "enum": [
        "text",
        "json",
        "image"
      ],
      "type": "string"
    },
    "TappApiAccess": {
      "enum": [
        "public",
        "protected",
        "manager"
      ],
      "type": "string"
    },
    "TappApiCredentialBinding": {
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/TappCredentialEncoding"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional host encoding of the secret before prefix/placement. Not for `sign`."
        },
        "field": {
          "description": "Destination name: header, query parameter, form field, or signature field.",
          "type": [
            "string",
            "null"
          ]
        },
        "header": {
          "description": "Legacy header name. Equivalent to `field` when `in` is header or omitted.",
          "type": [
            "string",
            "null"
          ]
        },
        "in": {
          "anyOf": [
            {
              "$ref": "#/$defs/TappCredentialIn"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the host applies the secret. Omitted with `header` means header (legacy)."
        },
        "key": {
          "description": "Key from top-level `manifest.credentials`.",
          "type": "string"
        },
        "prefix": {
          "description": "Optional literal prefix such as `Bearer `. Header placement only.",
          "type": [
            "string",
            "null"
          ]
        },
        "sign": {
          "anyOf": [
            {
              "$ref": "#/$defs/TappCredentialSign"
            },
            {
              "type": "null"
            }
          ],
          "description": "Host-only request signature. Required when `in` is `sign`."
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "TappApiDef": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "$ref": "#/$defs/TappApiAccess",
          "default": "protected"
        },
        "body": true,
        "bodyMode": {
          "$ref": "#/$defs/TappHttpBodyMode",
          "default": "json"
        },
        "builtin": {
          "type": [
            "string",
            "null"
          ]
        },
        "cacheTtl": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "credential": {
          "anyOf": [
            {
              "$ref": "#/$defs/TappApiCredentialBinding"
            },
            {
              "type": "null"
            }
          ],
          "description": "Host-only credential binding. The value is never added to the template\ncontext or returned to sandbox JavaScript."
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "inject": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "method": {
          "default": "GET",
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "DELETE",
            "CONNECT",
            "OPTIONS",
            "TRACE",
            "PATCH"
          ],
          "type": "string"
        },
        "spoof": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "default": "http",
          "type": "string"
        }
      },
      "type": "object"
    },
    "TappAuthor": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
