        "name"
      ],
      "type": "object"
    },
    "TappCategory": {
      "enum": [
        "ai",
        "data",
        "developer",
        "game",
        "media",
        "productivity",
        "social",
        "utility"
      ],
      "type": "string"
    },
    "TappCredentialDef": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "label"
      ],
      "type": "object"
    },
    "TappCredentialEncoding": {
      "enum": [
        "base64"
      ],
      "type": "string"
    },
    "TappCredentialIn": {
      "enum": [
        "header",
        "query",
        "form",
        "sign"
      ],
      "type": "string"
    },
    "TappCredentialSign": {
      "additionalProperties": false,
      "properties": {
        "alg": {
          "$ref": "#/$defs/TappCredentialSignAlg"
        },
        "over": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timestampField": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "alg",
        "over"
      ],
      "type": "object"
    },
    "TappCredentialSignAlg": {
      "enum": [
        "md5-sorted-kv",
        "hmac-sha256-raw"
      ],
      "type": "string"
    },
    "TappDataExchangeManifest": {
      "additionalProperties": false,
      "properties": {
        "exports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TappDataExport"
          },
          "type": "array"
        },
        "imports": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TappDataImport"
          },
          "type": "array"
        }
      },
