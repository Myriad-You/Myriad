        "name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "TappOpenUrlDef": {
      "additionalProperties": false,
      "description": "One install-time declared external navigation target.",
      "properties": {
        "id": {
          "description": "Stable id used by `Tapp.ui.openUrl({ id })` (not a free-form URL).",
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/TappOpenUrlMatch",
          "default": "exact",
          "description": "How runtime path/query may extend `url`. Defaults to exact.",
          "enum": [
            "exact",
            "prefix",
            "origin"
          ]
        },
        "url": {
          "description": "Base HTTPS URL (http only for localhost / 127.0.0.1).",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url"
      ],
      "type": "object"
    },
    "TappOpenUrlMatch": {
      "enum": [
        "exact",
        "prefix",
        "origin"
      ],
      "type": "string"
    },
    "TappSettingDef": {
      "additionalProperties": false,
      "properties": {
        "defaultValue": true,
        "description": {
          "type": [
            "string",
