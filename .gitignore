# =============================================================================
# Myriad root .gitignore
# =============================================================================

# --- Editor / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
*.iml
.project
.classpath
.settings/
.history/
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100
.Trashes
._*
.AppleDouble
.LSOverride
nul

# --- Local AI / tooling ---
# Keep /.claude/ ignored; settings.local.json must never be tracked.
/.claude/
.claude/settings.local.json
# Agent scratch: drafts, temporary specs, notes must not reach preview (see AGENTS.md).
/.scratch/

# --- Secrets / env ---
.env
/backend/data/.secret-key
/backend/.regen-token

# --- Dependencies (never commit accidental root installs) ---
/node_modules/
/.pnpm-store
/tools/tapp-cli/node_modules/

# --- Logs / temp ---
*.log
logs/
*.tmp
*.temp
*.bak
*.backup
*.old
*.cache
*.pid
/tmp

# --- Generic build outputs ---
/dist/
/build/
out/
*.build
/.astro
/tools/tapp-cli/dist/
/.verify-tapp-audit

# --- Docker local overrides / volumes ---
docker-compose.override.yml
docker/data/
docker/logs/
docker/volumes/

# --- Database files / local PG data ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/database/
/postgres-data/

# --- Rust targets & nested lockfiles ---
# Workspace root target (backend + migrations + crates)
/target/
# Legacy nested target from pre-workspace backend builds
/backend/target/
# Independent crates (not workspace members)
/proxy/target/
/updater/target/
/tools/tapp-contract-export/target/
/crates/tapp-contract/target/
# Nested lockfiles must not reappear under workspace members / tools
/backend/Cargo.lock
/backend/migrations/Cargo.lock
/tools/tapp-contract-export/Cargo.lock
/crates/tapp-contract/Cargo.lock

# --- Backend runtime data (seeded skills/*.md remain tracked) ---
/backend/data/phantasi
/backend/data/agent/memory
/backend/data/agent/skills/_stats.json
/backend/data/agent/skills/_gaps.json
/backend/data/agent/skills/_auto_*.md
/backend/data/agent/skills/.tmp_*
/backend/data/digital-life

# --- Frontend generated / local media ---
/frontend/public/digital-life

# --- Updater / deploy host runtime (never in git) ---
/state/
/backups/
/pgdata/
/guard-policy/
/.dev-updater/

# --- Misc local data trees ---
.tmp/
/data
/.pnpm-store
/Upload/
/tapp-store
backend/data/.bootstrap-claimed
/backend/data
.phantasi-shots/
/frontend/public/merope-demo
/frontend/tests/*
