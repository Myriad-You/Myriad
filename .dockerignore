# Git
.git
.gitignore
.gitattributes

# Documentation — allow only playground include_str! docs into backend Docker build.
# Note: *.md matches repo-root markdown only; docs/** controls the docs tree.
# Parent dirs must be un-excluded before files (Docker cannot re-include under a banned parent).
*.md
!README.md
docs/**
!docs/development/
!docs/development/**
!docs/features/
docs/features/**
!docs/features/TAPP_FILE_FORMAT.md
LICENSE

# Environment files
.env
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Backend specific
backend/target/
backend/.env
backend/.env.*

# Frontend specific
frontend/node_modules/
frontend/dist/
frontend/.astro/

# Database
database/*.sql
!database/schema.sql
!database/009_create_users_table.sql
!database/012_create_platform_metadata.sql
!database/013_create_metadata_history.sql

# Scripts
scripts/

# Docker
docker-compose.yml
docker-compose.*.yml
Dockerfile*
.dockerignore

# Cache and temp files
*.log
*.cache
.cache/
tmp/
temp/
backend/cache/
