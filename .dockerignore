# Git
.git
.gitignore
.gitattributes

# Documentation — allow only playground include_str! docs into backend Docker build.
# Note: *.md matches repo-root markdown only; docs/** controls the docs tree.
# Parent dirs must be un-excluded before files (Docker cannot re-include under a banned parent).
*.md
!README.md
docs/**
!docs/development/
!docs/development/**
!docs/features/
docs/features/**
!docs/features/TAPP_FILE_FORMAT.md
LICENSE

# Environment files
.env
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Rust build artifacts (never needed in image context)
/target/
backend/target/
proxy/target/
updater/target/
backend/.env
backend/.env.*

# Frontend specific
frontend/node_modules/
frontend/dist/
frontend/.astro/

# Packed images from scripts/build-and-pack.ps1 (never in build context)
/dist/

# Repo-root helper scripts only. Do not write **/scripts — that would
# drop frontend/scripts from the frontend image (v0.4.10-class miss).
/scripts/

# Docker
docker-compose.yml
docker-compose.*.yml
Dockerfile*
.dockerignore

# Cache and temp files
*.log
*.cache
.cache/
tmp/
temp/
backend/cache/
