# =============================================================================
# Myriad v3 环境变量示例（运维对照 / kiseki.blog 形状脱敏）
# =============================================================================
# 用法：
#   1. 复制为部署目录 .env（不要覆盖已有生产 secret）
#   2. 填入本机密钥；本文件中的 secret 一律为空或 CHANGE_ME
#   3. 与 v3-docker-compose.yml / 仓库根 docker-compose.yml 配套使用
#
# 警告：
#   - 切勿把真实 POSTGRES_PASSWORD / JWT_SECRET / UPDATE_TOKEN /
#     UPDATER_GATEWAY_SECRET / GITHUB_TOKEN 提交进 git
#   - UPDATER_TAG 对应镜像 **必须** 内含 myriad-docker-guard 与
#     myriad-updater-gateway 二进制；仅有旧版 updater 守护进程的镜像无法起 v3 拓扑
#   - 仅 UI 更新 **不能** 创建 admin-net / guard-net / gateway；需宿主 compose 一次
#
# 迁移说明：docs/deployment/MIGRATION_V2_TO_V3.md
# =============================================================================

# -----------------------------------------------------------------------------
# 镜像版本（示例：统一 release tag；三 tag 请保持一致或按需独立升级）
# -----------------------------------------------------------------------------
# 业务镜像 tag（updater 会改写）
MYRIAD_TAG=v0.2.6
# proxy / updater 独立节奏；须使用含 docker-guard + gateway 二进制的 updater 镜像
PROXY_TAG=v0.2.6
UPDATER_TAG=v0.2.6

# 业务镜像仓库（不含 tag）。commit 模式 pull / last-good 钉镜像依赖这两项
BACKEND_IMAGE=docker.io/somekawahitomi/myriad-backend
FRONTEND_IMAGE=docker.io/somekawahitomi/myriad-frontend
# PROXY_IMAGE=docker.io/somekawahitomi/myriad-proxy
# UPDATER_IMAGE=docker.io/somekawahitomi/myriad-updater

COMPOSE_PROJECT_NAME=myriad

# -----------------------------------------------------------------------------
# 三网命名（可选；默认即可。同机多套部署时再改）
# -----------------------------------------------------------------------------
# 业务网：proxy / frontend / backend / postgres（updater 不在此网）
# MYRIAD_DOCKER_NETWORK=myriad-net
#
# 管理平面：backend / updater / updater-gateway / proxy（rescue DNS）
# MYRIAD_ADMIN_NETWORK=myriad-admin-net
#
# 内部 guard 网（internal）：仅 updater + docker-guard；唯一允许挂 sock 的一侧
# MYRIAD_DOCKER_GUARD_NETWORK=myriad-docker-guard-net

# -----------------------------------------------------------------------------
# 密钥（脱敏：空或 CHANGE_ME；生产请用 openssl 生成 ≥32 字符）
# -----------------------------------------------------------------------------
# 生成: openssl rand -base64 36 | tr -d '\n=' | tr '+/' '-_'
# 注入：updater + updater-gateway + docker-guard。**不**注入 backend。
UPDATE_TOKEN=CHANGE_ME

# v3 新增：backend ↔ updater-gateway 共享密钥（≥32 字符）
# 注入：backend + updater-gateway。frontend 不持有。
# 从 v2 迁移时：保留原有 UPDATE_TOKEN / POSTGRES_PASSWORD / JWT_SECRET，
# 仅需新增本项（也可由 deploy.sh 在空值时自动生成）。
UPDATER_GATEWAY_SECRET=CHANGE_ME

POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME

# 可选：私有仓 / 提高 GitHub API 限额。公开 Docker Hub 发现可不设。
# GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# 更新通道与模式（kiseki.blog 运维形状：commit + preview）
# -----------------------------------------------------------------------------
# commit 模式下 CHANNEL 映射为 git 分支（preview / main / beta）
CHANNEL=preview
# release = GitHub Release / semver；commit = CI 的 dev-<sha> / 分支 tip
UPDATE_MODE=commit

MYRIAD_GITHUB_REPO=Myriad-You/Myriad
CHECK_INTERVAL_SECS=3600

# cosign：生产推荐 strict。off 需同时设 UPDATER_ALLOW_INSECURE_COSIGN=true
COSIGN_VERIFY=strict
# UPDATER_ALLOW_INSECURE_COSIGN=true
# COSIGN_INSECURE_OK=true

# -----------------------------------------------------------------------------
# 对外入口与域名（kiseki.blog 示例）
# -----------------------------------------------------------------------------
# 宿主只发布 proxy 端口；backend/frontend/updater/gateway/guard 均不映射公网
HTTP_PORT=8080

CORS_ORIGINS=https://kiseki.blog
BASE_URL=https://kiseki.blog
FRONTEND_URL=https://kiseki.blog

# 前端 API 基址：留空则浏览器走相对路径（推荐，同域反代）
PUBLIC_API_URL=

# 可选：外层 Nginx/Caddy/CDN 的 IP 或 CIDR（逗号分隔）。
# 仅列出的直接上游可通过 X-Forwarded-For / X-Real-IP 传真实客户端 IP。
# 切勿填 0.0.0.0/0；并应在防火墙限制仅这些上游可访问 HTTP_PORT。
# PROXY_TRUSTED_UPSTREAMS=192.0.2.10/32,2001:db8::10/128

# 直连 /_updater/* 救援通道（默认关闭；仅 backend 故障时临时打开）
PROXY_ALLOW_DIRECT_UPDATER=false

# 可选：镜像 mirror 前缀
# REGISTRY_MIRROR=mirror.example.com

# -----------------------------------------------------------------------------
# 安全检查清单（提交前自查）
# -----------------------------------------------------------------------------
# ✅ 无真实 secret 写入本文件或 git
# ✅ UPDATER_TAG 镜像含 docker-guard + gateway 二进制
# ✅ UPDATE_TOKEN / UPDATER_GATEWAY_SECRET 已替换为本机长随机串
# ✅ CORS_ORIGINS / BASE_URL / FRONTEND_URL 为实际 HTTPS origin
# ✅ 宿主未发布 1101 / 1104 / 2375
# =============================================================================
