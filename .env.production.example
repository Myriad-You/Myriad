# =============================================================================
# Myriad Production Environment Configuration
# =============================================================================
# 生产环境配置模板 - 复制此文件为 .env 并填写实际值
# cp .env.production.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 🚀 UPDATER REQUIRED
# -----------------------------------------------------------------------------
# 镜像版本固定 tag，由 updater 改写。首次部署填入要运行的版本。
MYRIAD_TAG=v0.4.8
PROXY_TAG=v0.4.6
UPDATER_TAG=v0.4.6
# TCB digest pin, written by Guard self-update. When set, compose prefers this
# over UPDATER_TAG. Do not treat UPDATER_TAG as the running updater identity.
# UPDATER_IMAGE_REF=docker.io/somekawahitomi/myriad-updater@sha256:REPLACE_WITH_64_HEX_DIGEST

# Guard 首次启动把下列项写入 ./guard-policy/docker-guard.env（updater 只读）。
# 必须填独立验证的 repo@sha256；禁止 :latest / 可变 tag。deploy 脚本在缺文件时
# 从本文件播种，并补齐空的 GUARD_SELF_UPDATE_TOKEN。
DOCKER_GUARD_IMAGE=docker.io/somekawahitomi/myriad-updater@sha256:REPLACE_WITH_64_HEX_DIGEST
GUARD_SELF_UPDATE_TOKEN=
GUARD_COMPOSE_PROJECT_NAME=myriad
# GUARD_MYRIAD_DOCKER_NETWORK=myriad-net
# GUARD_MYRIAD_ADMIN_NETWORK=myriad-admin-net
# GUARD_MYRIAD_DOCKER_GUARD_NETWORK=myriad-docker-guard-net
MYRIAD_GUARD_ENV_FILE=guard-policy/docker-guard.env

# 业务镜像仓库（不含 tag）。commit 模式 pull / rollback 钉镜像依赖这两项，不可省略。
BACKEND_IMAGE=docker.io/somekawahitomi/myriad-backend
FRONTEND_IMAGE=docker.io/somekawahitomi/myriad-frontend
# PROXY_IMAGE=docker.io/somekawahitomi/myriad-proxy
# UPDATER_IMAGE=docker.io/somekawahitomi/myriad-updater

# Compose 项目名默认为 myriad，updater 用它定位同一套 stack。
COMPOSE_PROJECT_NAME=myriad

# 可选：实际 Docker 网络名。默认固定为 myriad-net，不再由 Compose 自动加项目前缀。
# 同一台机器跑多套 Myriad 时再改这个值。
# MYRIAD_DOCKER_NETWORK=myriad-net

# 可选：管理平面网络（backend / updater / updater-gateway / proxy rescue）。默认 myriad-admin-net。
# MYRIAD_ADMIN_NETWORK=myriad-admin-net

# 可选：updater 与 docker-guard 的内部专用网络名。同机多套部署时应一并改名。
# MYRIAD_DOCKER_GUARD_NETWORK=myriad-docker-guard-net

# Updater API 鉴权 token（最少 32 字符）
# 生成方式: openssl rand -base64 36 | tr -d '\n=' | tr '+/' '-_'
# 注入：updater + updater-gateway。docker-guard 使用独立的宿主机策略文件，backend 不持有该 env。
UPDATE_TOKEN=

# Backend ↔ updater-gateway 共享密钥（最少 32 字符；deploy 脚本会补齐）
# 注入：backend + updater-gateway。frontend 不持有。
# 泄露 ≈ 可经 admin-net 上的 gateway 驱动更新（仍优于把 UPDATE_TOKEN 放进胖 backend）。
# 生成方式同 UPDATE_TOKEN。
UPDATER_GATEWAY_SECRET=

# Updater 跟踪的 release channel: stable | beta | nightly
# commit 模式下 channel 映射为 git 分支 main/preview/beta
CHANNEL=stable

# 更新模式: release（GitHub Release）| commit（CI dev-<sha>）
UPDATE_MODE=release

# 数据库相对 compose 的位置: bundled（默认）| external
# bundled: 更新时快照 ./pgdata，回滚可恢复数据目录 + 镜像 tag
# external: Postgres 在 compose 外；跳过 pgdata 快照/恢复，回滚只恢复镜像 tag
# 不会根据 DATABASE_URL 自动切换；外部库请显式设为 external
# MYRIAD_DB_MODE=bundled

# 可选：GitHub Token，用于提升 release API rate limit / 私有仓库
# GITHUB_TOKEN=

# 可选：镜像仓库 mirror 前缀（例如阿里云镜像）
# REGISTRY_MIRROR=mirror.example.com

# 可选：updater 跟踪的仓库
MYRIAD_GITHUB_REPO=Myriad-You/Myriad

# 可选：updater 主动检查更新的频率（秒）
CHECK_INTERVAL_SECS=3600

# 可选：proxy 暴露的 HTTP 端口
HTTP_PORT=80

# 可选：外层 Nginx/Caddy/CDN 代理的 IP 或 CIDR，多个值用逗号分隔。
# 留空（安全默认）：不信任任何转发头，根据 TCP 对端、请求协议和 Host 重建。
# Docker + 宿主反向代理必须填写 proxy 容器实际看到的宿主源地址；常见值可能是
# 172.17.0.1/32，但应以当前部署的网络检查结果为准，不能把示例当作通用默认。
# 非空：仅列表中的上游可传真实客户端 IP（公网或私网对端都不自动受信）。
# 请限制 HTTP_PORT 只允许代理访问；切勿填写 0.0.0.0/0。
# PROXY_TRUSTED_UPSTREAMS=172.17.0.1/32
#
# Backend 信任 Myriad proxy 改写的访客 IP（天气 /api/proxy/client-geo）。
# 这是独立的第二段信任链。compose 已默认开启并包含固定 myriad-net；
# 非 compose 部署应只填写 backend 视角下的 Myriad proxy 地址/网段：
# TRUST_PROXY_HEADERS=true
# TRUST_PROXY_PEERS=172.28.0.0/16
# 空 TRUST_PROXY_PEERS 使用 loopback + docker0 的窄内建默认；它与
# 空 PROXY_TRUSTED_UPSTREAMS（不信任任何上游）语义不同。

# 可选：是否启用 /_updater/* 直连通道（默认 false）
# 推荐保持关闭：UI 通过 /api/admin/updater/* 经 backend 鉴权访问。
# 仅在 backend 故障需要救援时打开。
PROXY_ALLOW_DIRECT_UPDATER=false

# 可选：cosign 签名验证策略
#   off    - 不验证（需同时设置 UPDATER_ALLOW_INSECURE_COSIGN=true，见下）
#   soft   - 验证失败仅打 warning，不阻止升级
#   strict - 验证失败直接拒绝升级（默认，推荐生产环境）
COSIGN_VERIFY=strict
# COSIGN_VERIFY=off 时的双钥匙确认（默认不要设置）。二选一即可：
# UPDATER_ALLOW_INSECURE_COSIGN=true
# COSIGN_INSECURE_OK=true

# -----------------------------------------------------------------------------
# 🔐 REQUIRED SECURITY SETTINGS (必须配置)
# -----------------------------------------------------------------------------

# PostgreSQL 数据库密码（强密码，最少 32 字符）
# 生成方式: openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT 密钥（用于用户认证，最少 32 字符）
# 生成方式: openssl rand -base64 32
JWT_SECRET=

# 安装暗号：官方 compose 已经写好 DATABASE_URL，未设置时会拒绝启动。
# deploy.sh / deploy.ps1 会在空值时生成。向导自己填库的原生安装不需要。
# 不要写进高级设置或任何已登录 API。
# MYRIAD_SETUP_SECRET=

# -----------------------------------------------------------------------------
# 🌐 CORS Configuration (生产环境必须配置)
# -----------------------------------------------------------------------------

# 允许访问的前端域名（多个域名用逗号分隔）
# 生产环境必须配置为实际域名，禁止使用 * 或留空
# 示例: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# 对外公开访问地址。联邦 WebFinger / Actor URL 和 OAuth fallback 都依赖它；
# 生产环境如果要让其他实例发现你，必须是公网 HTTPS origin。
BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# -----------------------------------------------------------------------------
# 🔧 Optional Configuration (可选配置)
# -----------------------------------------------------------------------------

# 站点访客统计：访客哈希盐（生产务必设置随机值，与 JWT_SECRET 无关）
# openssl rand -hex 32
# ANALYTICS_SALT=

# --- Official Tapp store install stats (no secrets in Myriad) ---
# 1 count per instance (BASE_URL) / app / UTC day. Never blocks install.
# Local/dev stays off unless you set ENABLED=true explicitly.
TAPP_STORE_STATS_URL=https://stats.store.myriad.you
TAPP_STORE_STATS_ENABLED=true

# 数据库端口映射（生产环境建议不暴露，留空即可）
# 如需调试可设置为: EXPOSE_DB_PORT=5432
# EXPOSE_DB_PORT=

# 生产环境只有 proxy 暴露宿主端口（HTTP_PORT）。backend:1103 / frontend:1102
# 是 docker 内部网络端口，不需要也不应直接映射到宿主机。

# 日志级别（error, warn, info, debug, trace）
# RUST_LOG=info

# -----------------------------------------------------------------------------
# 📝 Application Configuration (应用配置)
# -----------------------------------------------------------------------------
# 注意：以下配置建议通过 Web 界面管理（/api/config），而非环境变量。
# 官方 docker-compose 不把这些键注入容器；写在宿主 .env 里对 backend 无效。
# 非 Docker / 本机进程若设置了环境变量，启动时仍会同步到数据库。
# -----------------------------------------------------------------------------

# --- AI Provider Settings ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-exp

# --- Platform API Keys ---
# GITHUB_TOKEN=
# STEAM_API_KEY=
# BILIBILI_UID=
# YouTube Data API (report card / social widget channel stats)
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=       # UC… channel id
# Game presence widget (public IDs only; no user cookies)
# OPENXBL_API_KEY=          # Xbox via OpenXBL (https://xbl.io)
# PSN_NPSSO=                # PlayStation service account NPSSO (optional)
# X_USERNAME=your_handle
# X_BEARER_TOKEN=your_app_bearer_token
# Share-to-X uses Web Intent only (no X_ACCESS_TOKEN / OAuth)
# MAL_USERNAME=your_mal_username
# MAL_CLIENT_ID=                  # optional; with it uses official API, else public load.json

# --- OAuth Settings (推荐配置方式) ---
#
# 生产环境 OAuth 配置最佳实践：
#
# 方式1: 显式配置（最安全，强烈推荐）
# GITHUB_CLIENT_ID=your_production_client_id
# GITHUB_CLIENT_SECRET=your_production_client_secret
# GITHUB_REDIRECT_URL=https://yourdomain.com/api/auth/github/callback
# FRONTEND_URL=https://yourdomain.com
#
# 方式2: 使用基础URL（适合Docker/Kubernetes）
# BASE_URL=https://yourdomain.com
# FRONTEND_URL=https://yourdomain.com
# GITHUB_CLIENT_ID=your_production_client_id
# GITHUB_CLIENT_SECRET=your_production_client_secret
#
# 注意事项：
# 1. 确保在GitHub OAuth App设置中配置正确的回调URL
# 2. 生产环境必须使用HTTPS
# 3. FRONTEND_URL 用于OAuth成功后重定向到前端
# 4. 如果使用CDN，FRONTEND_URL可能与BASE_URL不同
#
# GitHub OAuth App配置步骤：
# 1. 访问 https://github.com/settings/developers
# 2. 创建新的OAuth App（生产环境专用）
# 3. Authorization callback URL: https://yourdomain.com/api/auth/github/callback
# 4. 复制 Client ID 和 Client Secret 到此配置文件

# =============================================================================
# 安全检查清单
# =============================================================================
# ✅ POSTGRES_PASSWORD 已设置强密码（32+ 字符）
# ✅ JWT_SECRET 已设置强密钥（32+ 字符）
# ✅ CORS_ORIGINS 已配置为实际域名（非 localhost）
# ✅ EXPOSE_DB_PORT 未设置（数据库不暴露到公网）
# ✅ POSTGRES_PASSWORD / JWT_SECRET 使用 openssl rand -base64 32 生成
# ✅ UPDATE_TOKEN 已由 deploy 脚本填充，或按上方 URL-safe 命令手动生成
# ✅ .env 文件已添加到 .gitignore
# =============================================================================
