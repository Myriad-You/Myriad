{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@config": [
        "./src/config.ts"
      ],
      "@myriad/figure": [
        "./packages/figure-interface/src/index.d.ts"
      ],
      "@myriad/figure/*": [
        "./packages/figure-interface/src/*.d.ts"
      ]
    }
  }
}
