# Environment variables for development
# Keep empty to use same-origin /api/* via the Astro dev proxy.
PUBLIC_API_URL=

# Optional: store install counts overlay (default: https://stats.store.myriad.you)
# Use local edge when running `cd tapp-store/edge && npm run dev`:
# VITE_TAPP_STORE_STATS_URL=http://127.0.0.1:8787
