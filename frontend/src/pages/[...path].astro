---
/**
 * SPA 回退路由
 * 捕获所有未匹配的路由，返回主应用页面
 * 让 React Router 处理客户端路由
 */
import { Font } from 'astro:assets'
import MachineReadableMetadata from '@components/MachineReadableMetadata.astro'
import NoScriptFallback from '@components/NoScriptFallback.astro'
import PageLoader from '@components/PageLoader.astro'
import App from '../App'
import '../styles/tailwind.css'

// 导出 getStaticPaths 以支持静态路由
// 在开发模式下，Astro 需要知道所有可能的路径
// 在生产模式下，serve -s 会将未匹配的路由回退到 index.html
export function getStaticPaths() {
  // 基础静态路由
  const staticRoutes = [
    'library',
    'reports',
    'config',
    'login',
    'register',
    'details',
    'setup',
    'tapp',
    'tapp/store',
    'tapp/playground',
    'tapp/run', // 多任务模式入口
    'brew', // Brew 阅读
  ]

  // DEV 专用页面。Astro dev 只服务 getStaticPaths 列出的路径，不列就是 404；
  // 生产不加进来，免得 prerender 出一个 dev/brew-tiles.html。
  if (import.meta.env.DEV) {
    staticRoutes.push('dev/brew-tiles') // Brew 磁贴人工扫查页
  }

  // 动态路由前缀 - 这些路由有动态参数
  // 生成 placeholder 路径用于开发模式，生产模式由 serve -s 处理
  const dynamicPrefixes = ['tapp/run', 'tapp/detail']

  // 为动态路由生成通用占位路径（开发模式下允许任意 ID）
  // 使用特殊标记 "_" 作为占位符，实际 ID 由 React Router 解析
  const dynamicRoutes = dynamicPrefixes.map((prefix) => `${prefix}/_`)

  // 合并所有路由
  const allRoutes = [...staticRoutes, ...dynamicRoutes]

  return allRoutes.map((route) => ({
    params: { path: route },
  }))
}

const title = 'Myriad - A myriad of lights, in one place.'
const description =
  'Myriad 是一个自托管的个人数字生活展示入口，用于聚合、整理和展示来自多个平台的个人数据。'
const myriadVersion = import.meta.env.PUBLIC_MYRIAD_VERSION || 'dev'
const myriadCommit = import.meta.env.PUBLIC_MYRIAD_COMMIT_SHA || ''
---

<!doctype html>
<html lang="zh-CN" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} id="meta-description" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/webp" href="/favicon.webp" id="favicon-link" />
    <!-- PWA manifest / install meta are applied by utils/pwa when pwa_enabled -->
    <link rel="manifest" href="/manifest.webmanifest" id="pwa-manifest-link" />
    <link rel="apple-touch-icon" href="/icons/pwa/icon-192.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Myriad" />
    <title>{title}</title>

    <!-- 安全策略 -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="myriad-version" content={myriadVersion} />
    <meta name="myriad-commit" content={myriadCommit} />
    <MachineReadableMetadata description={description} version={myriadVersion} />

    <!-- Astro 6 内置 Fonts API: 全部字体自托管，消除 Google Fonts 外部请求 -->
    <!-- 主体字体（预加载） -->
    <Font cssVariable="--font-inter" preload />
    <!-- 标题装饰字体（@font-face 预声明，浏览器按需下载字体文件） -->
    <Font
      cssVariable="--font-qwitcher-grypen"
      preload={[{ weight: 700, style: 'normal' }]}
    />
    <Font cssVariable="--font-codystar" />
    <Font cssVariable="--font-henny-penny" />
    <Font cssVariable="--font-srisakdi" />
    <Font cssVariable="--font-fleur-de-leah" />
    <Font cssVariable="--font-league-script" />
    <Font cssVariable="--font-megrim" />
    <Font cssVariable="--font-silkscreen" />
    <Font cssVariable="--font-unifraktur-maguntia" />
    <Font cssVariable="--font-cinzel" />

    <!-- Resource Hints优化 - DNS预解析和预连接 -->
    <link rel="dns-prefetch" href="https://api.fuukei.org" />
    <link rel="dns-prefetch" href="https://api.open-meteo.com" />
    <link rel="dns-prefetch" href="https://avatars.githubusercontent.com" />
    <!-- 关键外部 API 预连接（Lighthouse 建议） -->
    <link rel="preconnect" href="https://api.fuukei.org" crossorigin />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />

    <!-- 关键CSS内联 - 优化FCP -->
    <style>
      :root {
        --color-primary: #94a3b8;
        --bg-primary: #f5f5f5;
        --bg-card: rgba(255, 255, 255, 0.9);
        --text-primary: #1f2937;
        --text-secondary: #4b5563;
        --border-color: rgba(0, 0, 0, 0.1);
      }
      html.dark {
        --bg-primary: #0a0a0a;
        --bg-card: rgba(26, 26, 26, 0.9);
        --text-primary: #f9fafb;
        --text-secondary: #d1d5db;
        --border-color: rgba(255, 255, 255, 0.1);
      }
      html {
        scroll-behavior: smooth;
        overflow-x: hidden;
      }
      body {
        background: var(--bg-primary);
        color: var(--text-primary);
        font-family:
          var(--font-inter, 'Inter'),
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        margin: 0;
        padding: 0;
      }
      html::-webkit-scrollbar,
      body::-webkit-scrollbar {
        display: none;
        width: 0;
        height: 0;
      }
      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      /* .glass 表面样式统一由 theme.css 的表面令牌驱动。
         勿在页面级重复声明：html.dark .glass 的特异性 (0,2,1) 会
         盖掉令牌系统，导致 data-surface 主题在暗色下永远不生效 */
      .nav-container {
        position: fixed;
        bottom: 1rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 50;
      }
      @media (min-width: 768px) {
        .nav-container {
          left: 1.5rem;
          top: 50%;
          bottom: auto;
          transform: translateY(-50%);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>

    <!-- PWA：生产按 pwa_enabled 注册 SW；开发始终注销，避免旧缓存劫持 API -->
    <script>
      import { initPwaLifecycle } from '../utils/pwa'
      initPwaLifecycle()
    </script>

    <!-- 动态加载网站元数据 - 使用新的元数据管理工具 -->
    <script>
      // 导入元数据管理工具（需要在构建时处理）
      import { initSiteMetadata } from '../utils/siteMetadata'

      // 立即初始化元数据（优先使用缓存，避免闪烁）
      initSiteMetadata()
    </script>
  </head>
  <body class="antialiased">
    <!-- 页面加载器 -->
    <PageLoader />
    <NoScriptFallback description={description} />

    <!-- React 应用容器 - 初始隐藏，等待完全加载后显示 -->
    <div id="app-root">
      <App client:only="react" />
    </div>

    <!-- 初始化主题 -->
    <script>
      function initializeTheme() {
        const html = document.documentElement
        const stored = localStorage.getItem('theme')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        // 'auto' 或未设置时跟随系统外观
        const theme =
          stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light'

        if (theme === 'dark') {
          html.classList.add('dark')
          html.classList.remove('light')
        } else {
          html.classList.add('light')
          html.classList.remove('dark')
        }

        // 使用壁纸颜色（--color-primary）作为浏览器主题色
        const updateThemeColor = () => {
          const primaryColor =
            getComputedStyle(document.documentElement).getPropertyValue('--color-primary').trim() || '#94a3b8'
          const metaThemeColor = document.querySelector('meta[name="theme-color"]')
          if (metaThemeColor) {
            metaThemeColor.setAttribute('content', primaryColor)
          }
        }

        updateThemeColor()

        // 监听 CSS 变量变化，实时更新浏览器主题色
        const observer = new MutationObserver(updateThemeColor)
        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['style'],
        })

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          const current = localStorage.getItem('theme')
          if (!current || current === 'auto') {
            const newTheme = e.matches ? 'dark' : 'light'
            if (newTheme === 'dark') {
              html.classList.add('dark')
              html.classList.remove('light')
            } else {
              html.classList.add('light')
              html.classList.remove('dark')
            }
            // 更新主题色
            updateThemeColor()
          }
        })
      }

      initializeTheme()
    </script>

    <!-- 全局样式 (从 Layout.astro 提取) -->
