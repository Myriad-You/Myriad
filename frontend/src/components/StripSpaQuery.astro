<script is:inline>
  ;(function () {
    try {
      const u = new URL(location.href)
      if (u.searchParams.get('_spa') !== '1') return
      u.searchParams.delete('_spa')
      const q = u.searchParams.toString()
      history.replaceState(null, '', u.pathname + (q ? '?' + q : '') + u.hash)
    } catch {}
  })()
</script>
