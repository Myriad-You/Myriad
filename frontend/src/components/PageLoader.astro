---
/**
 * 页面加载过渡组件
 * 提供流畅自然的页面切换体验
 */
---

<div id="page-loader" class="page-loader" aria-live="polite" aria-busy="true">
  <div class="loader-content">
    <!-- 简洁的旋转圆环 -->
    <div class="loader-spinner"></div>
  </div>
</div>

<!-- React 应用占位容器，初始隐藏，等待完全加载后显示 -->
<style is:global>
  /* 应用容器初始状态：不可见但保留布局 */
  #app-root {
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: 0.05s;
  }

  /* 应用就绪后显示 */
  #app-root.app-ready {
    opacity: 1;
    transition-delay: 0s;
  }
</style>

<style>
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-primary, #f5f5f5);
    opacity: 1;
    pointer-events: all;
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0s;

    /* 性能优化 */
    will-change: opacity;
    transform: translateZ(0);
  }

  /* 深色模式加载器 */
  html.dark .page-loader {
    background: var(--bg-primary, #0a0a0a);
  }

  /* 隐藏状态 - 使用更长的过渡时间实现平滑淡出 */
  .page-loader.hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0.5s;
  }

  .loader-content {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 简洁的旋转圆环 - GPU优化 */
  .loader-spinner {
    width: 48px;
    height: 48px;
    border: 3px solid rgba(148, 163, 184, 0.2);
    border-top-color: var(--color-primary, #94a3b8);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    /* 使用translateZ替代will-change减少内存占用 */
    transform: translateZ(0);
  }

  /* 深色模式旋转圆环 */
  html.dark .loader-spinner {
    border: 3px solid rgba(148, 163, 184, 0.15);
    border-top-color: var(--color-primary, #94a3b8);
    box-shadow: 0 0 20px color-mix(in srgb, var(--color-primary, #94a3b8) 30%, transparent);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg) translateZ(0);
    }
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .loader-spinner {
      width: 40px;
      height: 40px;
      border-width: 2.5px;
    }
  }

  /* 减少动画（无障碍） */
  @media (prefers-reduced-motion: reduce) {
    .loader-spinner {
      animation: none;
      border-top-color: var(--color-primary, #94a3b8);
      border-right-color: var(--color-primary, #94a3b8);
    }
  }
</style>

<script>
  /**
   * 页面加载器控制类
   * 协调 PageLoader 隐藏和 React 应用显示的时序
   */
  class PageLoader {
    private loader: HTMLElement | null
    private appRoot: HTMLElement | null
    private isShowing: boolean = true
    private hideTimeout: number | null = null
    private isAppReady: boolean = false

    constructor() {
      this.loader = document.getElementById('page-loader')
      this.appRoot = null // 延迟获取，因为 React 可能还没挂载
    }

    /**
     * 显示加载器
     */
    show(): void {
      if (!this.loader) return

      if (this.hideTimeout) {
        clearTimeout(this.hideTimeout)
        this.hideTimeout = null
      }

      this.loader.classList.remove('hidden')
      this.loader.setAttribute('aria-busy', 'true')
      this.isShowing = true
      this.isAppReady = false

      // 同时隐藏应用
      if (this.appRoot) {
        this.appRoot.classList.remove('app-ready')
      }
    }

    /**
     * 标记应用已就绪（React 基础框架已加载）
     * 各个组件会独立控制自己的淡入显示
     */
    markAppReady(): void {
      if (this.isAppReady) return
      this.isAppReady = true

      // 获取应用根元素
      this.appRoot = document.getElementById('app-root')

      // 使用双帧确保 DOM 已更新
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          // 显示应用容器
          if (this.appRoot) {
            this.appRoot.classList.add('app-ready')
          }

          // 立即开始隐藏加载器
          this.hide(50)
        })
      })
    }

    /**
     * 隐藏加载器
     */
    hide(delay: number = 200): void {
      if (!this.loader) return

      this.hideTimeout = window.setTimeout(() => {
        if (this.loader) {
          this.loader.classList.add('hidden')
          this.loader.setAttribute('aria-busy', 'false')
          this.isShowing = false
        }
      }, delay)
    }

    /**
     * 检查是否正在显示
     */
    isActive(): boolean {
      return this.isShowing
    }

    /**
     * 检查应用是否已就绪
     */
    isReady(): boolean {
      return this.isAppReady
    }
  }

  // 创建全局实例
  if (typeof window !== 'undefined') {
    ;(window as any).pageLoader = new PageLoader()
  }
</script>
