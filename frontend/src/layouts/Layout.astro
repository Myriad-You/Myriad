---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Myriad - Multi-Platform Profile Aggregator' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <!-- Animated Background -->
    <div id="bg-container" class="fixed inset-0 -z-10 overflow-hidden">
      <!-- Dynamic Wallpaper -->
      <div id="wallpaper" class="absolute inset-0 bg-cover bg-center bg-no-repeat"></div>
      
      <!-- Overlay Gradient - Dynamic Colors -->
      <div id="overlay-gradient" class="absolute inset-0 bg-gradient-to-br from-green-50/95 via-pink-50/90 to-yellow-50/95"></div>
      
      <!-- Animated Mesh Gradient - Dynamic Colors -->
      <div class="absolute inset-0 opacity-30">
        <div id="blob-1" class="absolute top-0 -left-4 w-96 h-96 bg-green-400 rounded-full mix-blend-multiply filter blur-3xl animate-blob"></div>
        <div id="blob-2" class="absolute top-0 -right-4 w-96 h-96 bg-pink-400 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-2000"></div>
        <div id="blob-3" class="absolute -bottom-8 left-20 w-96 h-96 bg-yellow-300 rounded-full mix-blend-multiply filter blur-3xl animate-blob animation-delay-4000"></div>
      </div>
      
      <!-- Subtle Grid Pattern -->
      <div class="absolute inset-0 bg-grid-pattern opacity-[0.02]"></div>
    </div>

    <!-- Dynamic Island Navigation - Left Side Vertical -->
    <nav class="fixed left-6 top-1/2 -translate-y-1/2 z-50">
      <div class="dynamic-island shadow-2xl">
        <div class="flex flex-col items-center gap-3">
          <a href="/" class="nav-item" title="主页">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
          </a>
          
          <a href="/config" class="nav-item" title="配置">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </a>

          <!-- 分隔线 -->
          <div class="w-8 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>

          <!-- 生成报告按钮 -->
          <button id="generate-report-btn" class="nav-item generate-btn" title="生成报告">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <main class="relative z-10">
      <slot />
    </main>

    <style is:global>
      @keyframes blob {
        0%, 100% {
          transform: translate(0, 0) scale(1);
        }
        33% {
          transform: translate(30px, -50px) scale(1.1);
        }
        66% {
          transform: translate(-20px, 20px) scale(0.9);
        }
      }

      .animate-blob {
        animation: blob 7s infinite;
      }

      .animation-delay-2000 {
        animation-delay: 2s;
      }

      .animation-delay-4000 {
        animation-delay: 4s;
      }

      .bg-grid-pattern {
        background-image: 
          linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        background-size: 50px 50px;
      }

      body {
        font-family: 'Inter', sans-serif;
        background: #fef3c7;
        color: #1f2937;
      }

      /* Glass effect utility - Bright style */
      .glass {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.1);
      }

      /* Dynamic Island - 灵动岛样式（垂直布局，流动玻璃材质） */
      .dynamic-island {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 16px 12px;
        border: 2px solid rgba(34, 197, 94, 0.4);
        box-shadow: 0 8px 32px 0 rgba(34, 197, 94, 0.15),
                    inset 0 1px 0 0 rgba(255, 255, 255, 0.8);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
      }

      /* 动态渐变边框动画 */
      .dynamic-island::before {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 24px;
        padding: 2px;
        background: linear-gradient(135deg, 
          rgba(34, 197, 94, 0.6),
          rgba(236, 72, 153, 0.4),
          rgba(251, 191, 36, 0.4),
          rgba(34, 197, 94, 0.6)
        );
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        animation: border-flow 8s linear infinite;
        background-size: 300% 300%;
      }

      @keyframes border-flow {
        0%, 100% {
          background-position: 0% 50%;
        }
        50% {
          background-position: 100% 50%;
        }
      }

      .dynamic-island:hover {
        padding: 18px 12px;
        background: rgba(255, 255, 255, 0.85);
        box-shadow: 0 12px 48px 0 rgba(34, 197, 94, 0.25),
                    inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
      }

      /* Navigation items */
      .nav-item {
        @apply text-gray-500 hover:text-green-600 transition-all duration-300;
        @apply transform hover:scale-110 active:scale-95;
        @apply relative p-2.5;
        border-radius: 16px;
      }

      .nav-item:hover {
        background: rgba(34, 197, 94, 0.1);
      }

      /* Active nav item indicator */
      [aria-current="page"].nav-item {
        @apply text-green-600 bg-green-50;
      }

      /* Generate button with gradient border */
      .generate-btn {
        position: relative;
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.15), rgba(236, 72, 153, 0.15));
        border: 2px solid transparent;
      }

      .generate-btn::before {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 16px;
        padding: 2px;
        background: linear-gradient(135deg, 
          rgba(34, 197, 94, 0.8),
          rgba(236, 72, 153, 0.6),
          rgba(251, 191, 36, 0.6)
        );
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        animation: border-pulse 3s ease-in-out infinite;
      }

      @keyframes border-pulse {
        0%, 100% {
          opacity: 1;
        }
        50% {
          opacity: 0.5;
        }
      }

      .generate-btn:hover {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.25), rgba(236, 72, 153, 0.25));
        transform: scale(1.15);
      }

      .generate-btn:active {
        transform: scale(1.05);
      }

      .generate-btn.loading {
        animation: spin 1s linear infinite;
      }

      @keyframes spin {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      /* Smooth scrolling */
      html {
        scroll-behavior: smooth;
      }

      /* Custom scrollbar - Spring theme */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: rgba(254, 243, 199, 0.5);
      }
      ::-webkit-scrollbar-thumb {
        background: rgba(34, 197, 94, 0.5);
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: rgba(236, 72, 153, 0.7);
      }
    </style>

    <script>
      // Color extraction configuration
      const COLOR_EXTRACTION_CONFIG = {
        CANVAS_WIDTH: 192,
        CANVAS_HEIGHT: 108,
        QUANTIZATION_LEVELS: 16,
        MIN_PERCENTAGE: 0.5,
        MIN_SATURATION: 0.1,
        TOP_COLORS_COUNT: 5,
      };

      // Color extraction utility
      interface ColorInfo {
        rgb: string;
        hex: string;
        count: number;
        percentage: number;
        saturation: number;
      }

      // Convert RGB to hex
      function rgbToHex(r: number, g: number, b: number): string {
        return '#' + [r, g, b].map(x => {
          const hex = x.toString(16);
          return hex.length === 1 ? '0' + hex : hex;
        }).join('');
      }

      // Calculate saturation from RGB
      function calculateSaturation(r: number, g: number, b: number): number {
        const max = Math.max(r, g, b);
        const min = Math.min(r, g, b);
        if (max === 0) return 0;
        return (max - min) / max;
      }

      // Extract dominant colors from image
      async function extractColorsFromImage(imageUrl: string): Promise<ColorInfo[]> {
        return new Promise((resolve, reject) => {
          const img = new Image();
          img.crossOrigin = 'Anonymous';
          
          img.onload = () => {
            try {
              // Create canvas for color extraction
              const canvas = document.createElement('canvas');
              const ctx = canvas.getContext('2d', { willReadFrequently: true });
              
              if (!ctx) {
                reject(new Error('Could not get canvas context'));
                return;
              }

              // Use smaller size for performance (as configured)
              canvas.width = COLOR_EXTRACTION_CONFIG.CANVAS_WIDTH;
              canvas.height = COLOR_EXTRACTION_CONFIG.CANVAS_HEIGHT;
              
              // Draw scaled image
              ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
              
              // Get image data
              const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
              const pixels = imageData.data;
              
              // Count colors
              const colorMap = new Map<string, { count: number; r: number; g: number; b: number }>();
              
              // Sample every pixel
              for (let i = 0; i < pixels.length; i += 4) {
                const r = pixels[i];
                const g = pixels[i + 1];
                const b = pixels[i + 2];
                const a = pixels[i + 3];
                
                // Skip transparent pixels
                if (a < 128) continue;
                
                // Round colors to reduce noise (quantize based on configured levels)
                const quantize = COLOR_EXTRACTION_CONFIG.QUANTIZATION_LEVELS;
                const rRounded = Math.round(r / quantize) * quantize;
                const gRounded = Math.round(g / quantize) * quantize;
                const bRounded = Math.round(b / quantize) * quantize;
                
                const key = `${rRounded},${gRounded},${bRounded}`;
                
                if (colorMap.has(key)) {
                  colorMap.get(key)!.count++;
                } else {
                  colorMap.set(key, { count: 1, r: rRounded, g: gRounded, b: bRounded });
                }
              }
              
              // Convert to array and calculate percentages
              const totalPixels = canvas.width * canvas.height;
              const colors: ColorInfo[] = Array.from(colorMap.entries())
                .map(([_, value]) => {
                  const sat = calculateSaturation(value.r, value.g, value.b);
                  return {
                    rgb: `rgb(${value.r},${value.g},${value.b})`,
                    hex: rgbToHex(value.r, value.g, value.b),
                    count: value.count,
                    percentage: (value.count / totalPixels) * 100,
                    saturation: sat
                  };
                })
                // Filter: only keep colors with meaningful presence based on configured thresholds
                .filter(c => c.percentage > COLOR_EXTRACTION_CONFIG.MIN_PERCENTAGE && 
                             c.saturation > COLOR_EXTRACTION_CONFIG.MIN_SATURATION)
                // Sort by combination of frequency and saturation
                .sort((a, b) => {
                  const scoreA = a.percentage * (1 + a.saturation);
                  const scoreB = b.percentage * (1 + b.saturation);
                  return scoreB - scoreA;
                })
                .slice(0, COLOR_EXTRACTION_CONFIG.TOP_COLORS_COUNT);
              
              console.log(`[Color Extraction] Analyzed ${canvas.width}x${canvas.height} canvas`);
              console.log(`[Color Extraction] Found ${colorMap.size} unique colors from ${totalPixels} pixels`);
              console.log(`[Color Extraction] Top 5 significant colors:`, colors.map(c => 
                `${c.rgb} ${c.percentage.toFixed(1)}% sat:${c.saturation.toFixed(2)}`
              ));
              
              resolve(colors);
            } catch (error) {
              reject(error);
            }
          };
          
          img.onerror = () => {
            reject(new Error('Failed to load image'));
          };
          
          // Add cache-busting to ensure fresh image load
          const url = imageUrl.includes('?') 
            ? `${imageUrl}&_cb=${Date.now()}` 
            : `${imageUrl}?_cb=${Date.now()}`;
          img.src = url;
        });
      }

      // Apply extracted colors to UI
      function applyColorsToUI(colors: ColorInfo[]) {
        if (colors.length === 0) {
          console.log('[Color Extraction] No significant colors found, using defaults');
          return;
        }

        // Apply to overlay gradient
        const overlayGradient = document.getElementById('overlay-gradient');
        if (overlayGradient && colors.length >= 3) {
          const color1 = colors[0].rgb.replace('rgb(', 'rgba(').replace(')', ', 0.95)');
          const color2 = colors[1].rgb.replace('rgb(', 'rgba(').replace(')', ', 0.90)');
          const color3 = colors[2].rgb.replace('rgb(', 'rgba(').replace(')', ', 0.95)');
          overlayGradient.style.background = `linear-gradient(to bottom right, ${color1}, ${color2}, ${color3})`;
          console.log('[Color Extraction] Applied overlay gradient');
        }

        // Apply to animated blobs
        const blob1 = document.getElementById('blob-1');
        const blob2 = document.getElementById('blob-2');
        const blob3 = document.getElementById('blob-3');
        
        if (blob1 && colors[0]) {
          blob1.style.backgroundColor = colors[0].rgb;
          console.log('[Color Extraction] Applied blob-1 color:', colors[0].rgb);
        }
        if (blob2 && colors[1]) {
          blob2.style.backgroundColor = colors[1].rgb;
          console.log('[Color Extraction] Applied blob-2 color:', colors[1].rgb);
        }
        if (blob3 && colors[2]) {
          blob3.style.backgroundColor = colors[2].rgb;
          console.log('[Color Extraction] Applied blob-3 color:', colors[2].rgb);
        }

        // Store colors in sessionStorage with wallpaper URL as key
        const wallpaperEl = document.getElementById('wallpaper');
        if (wallpaperEl) {
          const bgImage = wallpaperEl.style.backgroundImage;
          if (bgImage) {
            const urlMatch = bgImage.match(/url\(["']?([^"')]+)["']?\)/);
            if (urlMatch) {
              const wallpaperUrl = urlMatch[1];
              sessionStorage.setItem(`wallpaper_colors_${wallpaperUrl}`, JSON.stringify(colors));
              console.log('[Color Extraction] Cached colors for:', wallpaperUrl);
            }
          }
        }
      }

      // Load wallpaper from config and extract colors
      async function loadWallpaper() {
        try {
          const response = await fetch('http://localhost:3000/api/config');
          const data = await response.json();
          const wallpaperEl = document.getElementById('wallpaper');
          
          if (wallpaperEl && data.ui_config?.wallpaper_url) {
            const wallpaperUrl = data.ui_config.wallpaper_url;
            wallpaperEl.style.backgroundImage = `url(${wallpaperUrl})`;
            wallpaperEl.style.filter = `blur(${data.ui_config.wallpaper_blur || 3}px)`;
            
            console.log('[Color Extraction] Loading wallpaper:', wallpaperUrl);
            
            // Check if we have cached colors for this exact wallpaper URL
            const cachedColorsStr = sessionStorage.getItem(`wallpaper_colors_${wallpaperUrl}`);
            if (cachedColorsStr) {
              try {
                const cachedColors = JSON.parse(cachedColorsStr);
                console.log('[Color Extraction] Using cached colors for current wallpaper');
                applyColorsToUI(cachedColors);
                return;
              } catch (e) {
                console.log('[Color Extraction] Failed to parse cached colors, extracting fresh');
              }
            }
            
            // Extract colors from the current wallpaper
            try {
              const colors = await extractColorsFromImage(wallpaperUrl);
              applyColorsToUI(colors);
            } catch (error) {
              console.log('[Color Extraction] Failed to extract colors:', error);
              console.log('[Color Extraction] Using default colors');
            }
          }
        } catch (error) {
          console.log('Using default background');
        }
      }
      
      // Set active nav state
      function setActiveNav() {
        const currentPath = window.location.pathname;
        const navItems = document.querySelectorAll('.nav-item:not(.generate-btn)');
        
        navItems.forEach(item => {
          const href = item.getAttribute('href');
          if (href === currentPath || (currentPath === '/' && href === '/')) {
            item.setAttribute('aria-current', 'page');
          } else {
            item.removeAttribute('aria-current');
          }
        });
      }

      // Handle generate report button
      function setupGenerateButton() {
        const generateBtn = document.getElementById('generate-report-btn');
        if (!generateBtn) return;

        generateBtn.addEventListener('click', async () => {
          // 检查是否在首页
          if (window.location.pathname !== '/') {
            window.location.href = '/';
            return;
          }

          // 调用 ReportCards 组件的生成函数
          if (typeof (window as any).generateReport === 'function') {
            generateBtn.classList.add('loading');
            try {
              await (window as any).generateReport();
            } finally {
              generateBtn.classList.remove('loading');
            }
          }
        });
      }
      
      loadWallpaper();
      setActiveNav();
      setupGenerateButton();
    </script>
  </body>
</html>
