{
  "name": "myriad-frontend",
  "type": "module",
  "version": "0.3.8",
  "description": "Frontend for Myriad — a myriad of lights, in one place.",
  "engines": {
    "node": ">=25 <26"
  },
  "scripts": {
    "astro": "cross-env GIT_PAGER= astro",
    "dev": "cross-env GIT_PAGER= astro dev",
    "build": "cross-env GIT_PAGER= astro build",
    "build:check": "pnpm typecheck && pnpm build",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; for (const p of ['dist', '.astro']) fs.rmSync(p, { recursive: true, force: true })\"",
    "preview": "cross-env GIT_PAGER= astro preview",
    "format": "prettier --write .",
    "lint": "eslint . --ignore-pattern '**/*.md'",
    "stylelint": "stylelint \"src/**/*.css\"",
    "test": "pnpm test:unit && pnpm lint && pnpm stylelint && pnpm typecheck",
    "test:unit": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck": "cross-env GIT_PAGER= astro check",
    "eslint:debug": "eslint --debug .",
    "eslint:inspect": "npx @eslint/config-inspector",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/compiler-rs": "^0.3.1",
    "@astrojs/react": "^6.0.1",
    "astro": "^7.1.3",
    "axios": "^1.18.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "taze": "^19.14.1",
    "terser": "^5.49.0",
    "tsx": "^4.23.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
