{
  "name": "myriad-frontend",
  "type": "module",
  "version": "0.5.1",
  "packageManager": "pnpm@11.25.0",
  "description": "Frontend for Myriad — a myriad of lights, in one place.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "astro": "cross-env GIT_PAGER= astro",
    "dev": "cross-env GIT_PAGER= astro dev",
    "build": "cross-env GIT_PAGER= astro build",
    "build:check": "pnpm typecheck && pnpm build",
    "optimize:icons": "node scripts/optimize-icons.mjs",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; for (const p of ['dist', '.astro']) fs.rmSync(p, { recursive: true, force: true })\"",
    "preview": "cross-env GIT_PAGER= astro preview",
    "start": "node scripts/spa-server.mjs",
    "format": "prettier --write .",
    "lint": "eslint . --ignore-pattern '**/*.md'",
    "stylelint": "stylelint \"src/**/*.css\"",
    "test": "pnpm test:unit && pnpm lint && pnpm stylelint && pnpm typecheck",
    "test:unit": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:browser": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:live-performance": "playwright test --config playwright.live-performance.config.ts",
    "test:production-budget": "playwright test --config playwright.production.config.ts",
    "test:home-budget": "node scripts/home-budget.mjs --check",
    "typecheck": "cross-env GIT_PAGER= astro check",
    "eslint:debug": "eslint --debug .",
    "eslint:inspect": "npx @eslint/config-inspector",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "^0.4.0",
    "@astrojs/react": "^6.0.5",
    "ag-psd": "^31.0.2",
    "agora-rtc-sdk-ng": "^4.24.8",
    "agora-rtm": "^2.3.0",
    "astro": "^7.3.2",
    "axios": "^1.20.0",
    "isomorphic-dompurify": "^4.2.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "pinyin-pro": "3.29.4",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "sharp": "0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "taze": "^21.1.0",
    "terser": "^5.51.2",
    "tsx": "^4.23.13",
    "vite": "^8.3.0"
  }
}
