{
  "name": "myriad-frontend",
  "type": "module",
  "version": "0.7.1",
  "packageManager": "pnpm@11.25.0",
  "description": "Frontend for Myriad — a myriad of lights, in one place.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "pnpm typecheck && pnpm build",
    "optimize:icons": "node scripts/optimize-icons.mjs",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; for (const p of ['dist', 'node_modules/.vite']) fs.rmSync(p, { recursive: true, force: true })\"",
    "preview": "vite preview",
    "start": "node scripts/spa-server.mjs",
    "format": "prettier --write .",
    "lint": "eslint . --ignore-pattern '**/*.md' && cd ../tapp/runtime && eslint .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "test": "pnpm test:unit && pnpm lint && pnpm stylelint && pnpm typecheck",
    "test:unit": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"../figure/src/**/*.test.ts\" \"../tapp/runtime/src/**/*.test.ts\"",
    "test:browser": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:live-performance": "playwright test --config playwright.live-performance.config.ts",
    "test:production-budget": "playwright test --config playwright.production.config.ts",
    "test:home-budget": "node scripts/home-budget.mjs --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../figure && tsc --noEmit -p ../tapp/runtime",
    "eslint:debug": "eslint --debug .",
    "eslint:inspect": "npx @eslint/config-inspector",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@myriad/figure": "workspace:*",
    "@myriad/tapp-runtime": "workspace:*",
    "ag-psd": "^31.0.3",
    "agora-rtc-sdk-ng": "^4.24.9",
    "agora-rtm": "^2.3.0",
    "isomorphic-dompurify": "^4.6.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide-react": "^1.61.0",
    "motion": "^13.2.0",
    "pinyin-pro": "3.29.5",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "taze": "^21.3.0",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "vite": "^8.3.5"
  }
}
