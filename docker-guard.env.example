# Copy this file OUTSIDE the updater-writable deployment root, normally to:
#   Linux:   /etc/myriad/docker-guard.env
#   Windows: C:\ProgramData\Myriad\docker-guard.env
#
# Pin the updater image to the exact Docker Hub digest verified by the host
# administrator. During the private-repository phase this is the #265
# Docker-Hub control-plane trust boundary; mutable tags are forbidden here.
DOCKER_GUARD_IMAGE=docker.io/somekawahitomi/myriad-updater@sha256:REPLACE_WITH_64_HEX_DIGEST

# Guard trust policy. Keep these values host-owned; the application .env may
# contain matching operational values but is not authoritative for the TCB.
# The trusted one-shot self-update handoff may change only DOCKER_GUARD_IMAGE,
# using atomic file replacement, to another Guard-resolved official digest.
GUARD_COMPOSE_PROJECT_NAME=myriad
GUARD_MYRIAD_DOCKER_NETWORK=myriad-net
GUARD_MYRIAD_ADMIN_NETWORK=myriad-admin-net
GUARD_MYRIAD_DOCKER_GUARD_NETWORK=myriad-docker-guard-net

# The compose bind source is also resolved from the host-owned env file so a
# compromised updater cannot redirect the Guard policy mount on a later host run.
MYRIAD_GUARD_ENV_FILE=/etc/myriad/docker-guard.env
