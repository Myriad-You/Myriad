# syntax=docker/dockerfile:1.6
# Backend Dockerfile - Multi-stage build for optimal size
# Pin with proxy/updater. Floating `rustlang/rust:nightly-*` hit a rustc ICE
# compiling tokio under release LTO (nightly 2026-07-25). sea-orm 2 / sqlx 0.9
# require rustc >= 1.94.
FROM rust:1.99-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Monorepo layout: playground sources use include_str!("../../../docs/...")
# relative to backend/src/{api,services}, so the build tree must be
# /build/backend/src/... with docs at /build/docs/...
#
# Cargo workspace root is /build (virtual workspace); members:
#   backend, backend/migrations, crates/*
# The Tapp contract and rules are path dependencies under tapp/crates (their
# own workspace, excluded here like core/).
# Cargo loads every member manifest even for `cargo build -p myriad-backend`.
# The shared core is the `core/` git submodule (path deps under core/crates,
# contracts under core/shared); the build context needs it checked out.
WORKDIR /build

# Build-time version stamp consumed by /health (see api/mod.rs).
ARG MYRIAD_VERSION=v0.0.0-dev
ENV MYRIAD_VERSION=${MYRIAD_VERSION}
ARG MYRIAD_COMMIT_SHA=unknown
ENV MYRIAD_COMMIT_SHA=${MYRIAD_COMMIT_SHA}

# `release` = full LTO (local/default). `ci-release` = thin LTO for image CI.
ARG CARGO_PROFILE=release
# Bound concurrent compiler processes on small Docker builders; CI can override.
ARG CARGO_BUILD_JOBS=2

# Workspace root + member manifests (single shared Cargo.lock)
COPY Cargo.toml Cargo.lock ./
COPY backend/Cargo.toml ./backend/
COPY backend/migrations ./backend/migrations
COPY crates ./crates
COPY core ./core
COPY tapp/crates ./tapp/crates
# The sandbox contract via include_str! in tapp-contract (../../../shared/... → /build/tapp/shared/)
COPY tapp/shared ./tapp/shared

# Copy actual source code early to avoid dummy build issues
COPY backend/src ./backend/src
COPY backend/i18n ./backend/i18n
# Style reference compiled in via include_bytes! in merope_rig.rs
COPY backend/assets ./backend/assets

# Shared host list via include_str! in profile.rs (../../../shared/... → /build/shared/)
COPY shared ./shared

# Docs embedded at compile time via include_str! in tapp_playground*.rs and
# tapp_host_attribution.rs: the site's own under docs/, the app author docs
# and permission fixtures under tapp/docs/
COPY docs/development ./docs/development
COPY tapp/docs ./tapp/docs

# Cache mounts keep registry/git/target across builds. Binary must be copied
# out of the target mount — mount contents are not part of the image layer.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/build/target,sharing=locked \
    cargo build --locked -p myriad-backend --profile="${CARGO_PROFILE}" --jobs="${CARGO_BUILD_JOBS}" \
    && cp "target/${CARGO_PROFILE}/myriad-backend" /build/myriad-backend \
    && strip /build/myriad-backend

# Blog site generator. Pinned with checksums from the upstream releases
# (hugo_<ver>_checksums.txt; Dart Sass asset digests on GitHub). Themes that
# compile SCSS need Dart Sass; Hugo's extended edition is what most themes ask for.
FROM debian:bookworm-slim AS blog-tools
ARG TARGETARCH
ARG HUGO_VERSION=0.168.0
ARG HUGO_SHA256_AMD64=787f100057328824f38c6ad7c87ff10d6451ae0a7bc39cedaad0dd2bcde17e53
ARG HUGO_SHA256_ARM64=b975ba150a464f57115bdf6cbf6638224906461fdcf863821ec983f8602a442c
ARG DART_SASS_VERSION=1.105.1
ARG DART_SASS_SHA256_AMD64=9046fdd4a31a524a0020298c55d9e155d4c22363ef268e8992574335a72c6a6f
ARG DART_SASS_SHA256_ARM64=7f53a2a77ef4aaf24a9f2f8c826759ed93b38954430a2e32130921a2e16a4a1c
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) hugo_arch=amd64; sass_arch=x64; hugo_sha="${HUGO_SHA256_AMD64}"; sass_sha="${DART_SASS_SHA256_AMD64}" ;; \
      arm64) hugo_arch=arm64; sass_arch=arm64; hugo_sha="${HUGO_SHA256_ARM64}"; sass_sha="${DART_SASS_SHA256_ARM64}" ;; \
      *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/hugo.tgz \
      "https://github.com/gohugoio/hugo/releases/download/v${HUGO_VERSION}/hugo_extended_${HUGO_VERSION}_linux-${hugo_arch}.tar.gz"; \
    echo "${hugo_sha}  /tmp/hugo.tgz" | sha256sum -c -; \
    mkdir -p /out/bin; \
    tar -xzf /tmp/hugo.tgz -C /out/bin hugo; \
    curl -fsSL -o /tmp/sass.tgz \
      "https://github.com/sass/dart-sass/releases/download/${DART_SASS_VERSION}/dart-sass-${DART_SASS_VERSION}-linux-${sass_arch}.tar.gz"; \
    echo "${sass_sha}  /tmp/sass.tgz" | sha256sum -c -; \
    tar -xzf /tmp/sass.tgz -C /out; \
    /out/bin/hugo version; \
    /out/dart-sass/sass --version

# Runtime stage - minimal image
FROM debian:bookworm-slim AS runtime

ARG MYRIAD_VERSION=v0.0.0-dev
ENV MYRIAD_VERSION=${MYRIAD_VERSION}
ARG MYRIAD_COMMIT_SHA=unknown
ENV MYRIAD_COMMIT_SHA=${MYRIAD_COMMIT_SHA}
# Cap glibc thread arenas (default 8*nCPU x 64MiB). Compose may override.
ENV MALLOC_ARENA_MAX=4
LABEL org.opencontainers.image.revision=${MYRIAD_COMMIT_SHA}
LABEL io.myriad.runtime.federation-worker="1"
LABEL io.myriad.runtime.persona-worker="1"
LABEL io.myriad.runtime.federation-http="1"

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    util-linux \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/myriad-backend /app/myriad-backend
COPY --from=blog-tools /out/bin/hugo /usr/local/bin/hugo
COPY --from=blog-tools /out/dart-sass /opt/dart-sass
ENV HUGO_BIN=/usr/local/bin/hugo
ENV DART_SASS_DIR=/opt/dart-sass
COPY docker/backend-entrypoint.sh /usr/local/bin/myriad-backend-entrypoint

# Create cache directory
# The dedicated path is absent in older images, so an old image can never
# accidentally run a full backend when a worker is requested during rollback.
RUN mkdir -p /app/cache && ln -s /app/myriad-backend /app/myriad-federation-worker && ln -s /app/myriad-backend /app/myriad-persona-worker

# Create a non-root user
RUN useradd -m -u 1000 myriad && \
    chown -R myriad:myriad /app && \
    chmod 0755 /usr/local/bin/myriad-backend-entrypoint

USER myriad

ENTRYPOINT ["/usr/local/bin/myriad-backend-entrypoint"]

EXPOSE 1103

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:1103/health || exit 1

CMD ["/app/myriad-backend"]
