# syntax=docker/dockerfile:1.6
# Frontend Dockerfile - Multi-stage build
#
# Stages:
#   builder — pnpm install + build (arch-independent assets)
#   assets  — /dist layout; overridable via `--build-context assets=...`
#   export  — local/CI artifact export (`-o type=local`)
#   runtime — serve static dist
#
# CI builds assets once on amd64, then packages runtime per-arch with:
#   --build-context assets=./frontend-export
ARG NODE_VERSION=24
ARG PNPM_VERSION=10.28.2

# Prefer the builder machine's native arch (avoids QEMU for Node when used).
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/pnpm-lock.yaml ./

# Disable husky in Docker (no .git directory)
ENV HUSKY=0

# Install dependencies. Prefer an explicit pnpm pin over Corepack so builder
# and CI stay aligned regardless of the Node image's Corepack defaults.
ARG PNPM_VERSION
RUN npm install --global pnpm@${PNPM_VERSION} && \
    pnpm install --frozen-lockfile

# Copy source code and config
COPY frontend/ ./

# Hotlink host list imported by src/utils/proxyImageUrl.ts
# (../../../shared/... from /app/src/utils → /shared/...)
COPY shared/image_proxy_hosts.json /shared/image_proxy_hosts.json

# Build argument for backend URL
# 默认为空字符串，使用相对路径（生产环境推荐）
ARG BACKEND_URL=
ENV PUBLIC_API_URL=${BACKEND_URL}

# Build-time version stamp injected into <meta name="myriad-version">.
ARG MYRIAD_VERSION=v0.0.0-dev
ENV PUBLIC_MYRIAD_VERSION=${MYRIAD_VERSION}
ARG MYRIAD_COMMIT_SHA=unknown
ENV PUBLIC_MYRIAD_COMMIT_SHA=${MYRIAD_COMMIT_SHA}

# Build the application
RUN pnpm run build

# Canonical /dist layout. CI may replace this stage with a prebuilt context:
#   docker buildx build --build-context assets=./frontend-export ...
FROM builder AS assets
RUN mkdir -p /dist && cp -a /app/dist/. /dist/

# Export for `docker build --target export -o type=local,dest=...`
FROM scratch AS export
COPY --from=assets /dist /dist

# Runtime stage - lightweight server (TARGETPLATFORM)
FROM node:${NODE_VERSION}-alpine AS runtime

ARG MYRIAD_COMMIT_SHA=unknown
LABEL org.opencontainers.image.revision=${MYRIAD_COMMIT_SHA}

WORKDIR /app

# Install serve globally and create user
RUN npm install -g serve@14.2.6 && \
    (addgroup -g 1000 myriad 2>/dev/null || addgroup myriad) && \
    (adduser -D -u 1000 -G myriad myriad 2>/dev/null || adduser -D -G myriad myriad)

# Copy built assets from assets stage (or prebuilt build-context)
COPY --from=assets --chown=myriad:myriad /dist ./dist

# Switch to non-root user
USER myriad

EXPOSE 1102

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:1102 || exit 1

# Serve the built application
# 使用 -s (SPA模式) 将所有未匹配的路由回退到 index.html
# 这样 React Router 可以在客户端处理动态路由（如 /tapp/run/:id）
CMD ["serve", "dist", "-s", "-l", "1102", "--no-clipboard"]
