# syntax=docker/dockerfile:1.6
# Frontend Dockerfile - Multi-stage build
#
# Stages:
#   builder — pnpm install + build (arch-independent assets)
#   assets  — /dist layout; overridable via `--build-context assets=...`
#   export  — local/CI artifact export (`-o type=local`)
#   runtime — spa-server (static + site-identity stamp)
#
# CI builds assets once on amd64, then packages runtime per-arch with:
#   --build-context assets=./frontend-export
ARG NODE_VERSION=24
ARG PNPM_VERSION=11.25.0

# Prefer the builder machine's native arch (avoids QEMU for Node when used).
FROM --platform=$BUILDPLATFORM node:${NODE_VERSION}-alpine AS builder

# The builder mirrors the repo under /src/ (frontend at /src/frontend). The
# pnpm workspace reaches up into ../figure and ../tapp/runtime; with the root
# at /app those resolve beside /, and pnpm 11 then installs nothing — exit 0,
# no packages, `vite: not found` at build time. Keep the workspace root one
# level below a non-root parent.
WORKDIR /src/frontend

# Copy package files (workspace yaml carries pnpm overrides / settings).
# patchedDependencies hashes the patch files during install — they must
# be in the layer before `pnpm install`, not only with the later source COPY.
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
COPY frontend/patches ./patches
# The 2.5D figure (figure/ submodule) is a workspace package at ../figure.
COPY figure/package.json /src/figure/package.json
# The Tapp runtime (tapp/ submodule) is a workspace package at ../tapp/runtime.
COPY tapp/runtime/package.json /src/tapp/runtime/package.json

# Disable husky in Docker (no .git directory)
ENV HUSKY=0

# Install dependencies. Prefer an explicit pnpm pin over Corepack so builder
# and CI stay aligned regardless of the Node image's Corepack defaults.
ARG PNPM_VERSION
RUN npm install --global pnpm@${PNPM_VERSION} && \
    pnpm install --frozen-lockfile

# Copy source code and config
COPY frontend/ ./

# Shared static contracts imported by frontend source
# (relative ../../../shared/... from /src/frontend/src/... → /src/shared/...)
COPY shared /src/shared
# Rig and performance contracts from the shared-core submodule
# (@myriad/core/shared/... → /src/core/shared/...)
COPY core/shared /src/core/shared
# The 2.5D figure's source (@myriad/figure → /src/figure/src)
COPY figure/src /src/figure/src
# and the rig / performance contract copies it reads (../../contracts/... →
# /src/figure/contracts; figure keeps its own byte-for-byte copies of core's).
COPY figure/contracts /src/figure/contracts
# The Tapp runtime's source (@myriad/tapp-runtime → /src/tapp/runtime/src) and
# the sandbox contract it imports (../../shared/... → /src/tapp/shared)
COPY tapp/runtime/src /src/tapp/runtime/src
COPY tapp/shared /src/tapp/shared

# Built-in TAPP sources bundled as examples
# (relative ../../../../../tapps/... from /src/frontend/src/tapp/examples/tapps/... → /src/tapps/...)
COPY tapps /src/tapps

# Build argument for backend URL
# 默认为空字符串，使用相对路径（生产环境推荐）
ARG BACKEND_URL=
ENV PUBLIC_API_URL=${BACKEND_URL}

# Build-time version stamp injected into <meta name="myriad-version">.
ARG MYRIAD_VERSION=v0.0.0-dev
ENV PUBLIC_MYRIAD_VERSION=${MYRIAD_VERSION}
ARG MYRIAD_COMMIT_SHA=unknown
ENV PUBLIC_MYRIAD_COMMIT_SHA=${MYRIAD_COMMIT_SHA}

# Build the application
RUN --network=none pnpm run build

# Canonical /dist layout. CI may replace this stage with a prebuilt context:
#   docker buildx build --build-context assets=./frontend-export ...
FROM builder AS assets
RUN mkdir -p /dist && cp -a /src/frontend/dist/. /dist/

# Export for `docker build --target export -o type=local,dest=...`
FROM scratch AS export
COPY --from=assets /dist /dist

# Runtime stage - lightweight server (TARGETPLATFORM)
FROM node:${NODE_VERSION}-alpine AS runtime

ARG MYRIAD_VERSION=v0.0.0-dev
ENV MYRIAD_VERSION=${MYRIAD_VERSION}
ARG MYRIAD_COMMIT_SHA=unknown
ENV MYRIAD_COMMIT_SHA=${MYRIAD_COMMIT_SHA}
LABEL org.opencontainers.image.revision=${MYRIAD_COMMIT_SHA}

WORKDIR /app

# Non-root user; no global static-file server — spa-server.mjs stamps branding.
RUN (addgroup -g 1000 myriad 2>/dev/null || addgroup myriad) && \
    (adduser -D -u 1000 -G myriad myriad 2>/dev/null || adduser -D -G myriad myriad)

# Copy built assets from assets stage (or prebuilt build-context).
# Keep spa-server in scripts/ so relative imports stay the repo layout.
# Do not flatten individual files — that is how v0.4.10 shipped without
# astro/constants.mjs and crashed on boot.
COPY --from=assets --chown=myriad:myriad /dist ./dist
COPY --chown=myriad:myriad frontend/scripts ./scripts

# Switch to non-root user
USER myriad

EXPOSE 1102

# Alpine/busybox wget: no GNU --no-verbose / --tries.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget -q -T 5 --spider http://127.0.0.1:1102 || exit 1

# SPA fallback + stamp site title/icon from operator-configured metadata URL.
# Proxy does not rewrite HTML. Crawler / share shells stay on backend.
ENV DIST_DIR=/app/dist
ENV PORT=1102
CMD ["node", "scripts/spa-server.mjs"]
