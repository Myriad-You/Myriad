# Frontend Dockerfile - Multi-stage build
ARG NODE_VERSION=20
ARG PNPM_VERSION=9.15.4
ARG PACKAGE_MANAGER=pnpm
FROM node:${NODE_VERSION}-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/pnpm-lock.yaml* frontend/package-lock.json* ./

# Install dependencies (use npm install if lock file doesn't exist)
ARG PNPM_VERSION
ARG PACKAGE_MANAGER
RUN if [ "$PACKAGE_MANAGER" = "pnpm" ]; then \
      corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate && \
      if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi; \
    else \
      if [ -f package-lock.json ]; then npm ci; else npm install; fi; \
    fi

# Copy source code and config
COPY frontend/ ./

# Build argument for backend URL
# 默认为空字符串，使用相对路径（生产环境推荐）
ARG BACKEND_URL=
ENV PUBLIC_API_URL=${BACKEND_URL}

# Build the application
RUN if [ "$PACKAGE_MANAGER" = "pnpm" ]; then pnpm run build; else npm run build; fi

# Runtime stage - lightweight server
FROM node:${NODE_VERSION}-alpine

WORKDIR /app

# Install serve globally and create user
RUN npm install -g serve@14 && \
    (addgroup -g 1000 myriad 2>/dev/null || addgroup myriad) && \
    (adduser -D -u 1000 -G myriad myriad 2>/dev/null || adduser -D -G myriad myriad)

# Copy built assets from builder
COPY --from=builder --chown=myriad:myriad /app/dist ./dist

# Switch to non-root user
USER myriad

EXPOSE 4321

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:4321 || exit 1

# Serve the built application
# 使用 -s (SPA模式) 将所有未匹配的路由回退到 index.html
# 这样 React Router 可以在客户端处理动态路由（如 /tapp/run/:id）
CMD ["serve", "dist", "-s", "-l", "4321", "--no-clipboard"]
