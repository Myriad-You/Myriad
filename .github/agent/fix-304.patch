 //! Base API routes (setup, system, public config, federation surface).
 use super::*;
 
+/// Gate setup control-plane mutations before their handlers run.
+///
+/// Keeping this at the route boundary guarantees the installation capability is
+/// checked before `create_admin` reaches Argon2 or any database mutation.
+async fn require_setup_bootstrap(req: Request, next: Next) -> Response {
+    if let Err(error) = crate::api::setup_bootstrap::require_bootstrap(req.headers()) {
+        return crate::error::HttpError(error).into_response();
+    }
+    next.run(req).await
+}
+
+/// First-owner creation consumes the capability only after the handler has
+/// committed successfully. Failed validation/DB work leaves the capability usable
+/// so the legitimate operator can correct the request without restarting.
+async fn require_and_consume_setup_bootstrap(req: Request, next: Next) -> Response {
+    if let Err(error) = crate::api::setup_bootstrap::require_bootstrap(req.headers()) {
+        return crate::error::HttpError(error).into_response();
+    }
+
+    let response = next.run(req).await;
+    if response.status().is_success() {
+        crate::api::setup_bootstrap::consume_bootstrap();
+    }
+    response
+}
+
 /// Config-mode only: no DB / no `AppState`. Setup + public auth bootstrap surface.
 ///
 /// Handlers that need a live DB use `extract::Db` and get **503** (not 404) when
@@ -14,9 +44,14 @@ pub(super) fn build_config_mode_router() -> Router {
             post(api::setup::save_database_config),
         )
         .route(
             "/api/setup/init-database",
-            post(api::setup::init_database),
+            post(api::setup::init_database).route_layer(from_fn(require_setup_bootstrap)),
+        )
+        .route(
+            "/api/setup/create-admin",
+            post(api::auth_local::create_admin)
+                .route_layer(from_fn(require_and_consume_setup_bootstrap)),
         )
-        .route("/api/setup/create-admin", post(api::auth_local::create_admin))
         // system status stays public for operators during setup
         .route("/api/system/status", get(api::system::system_status))
         // OAuth discovery + login redirect (no AppState); avoids 404→login broken in setup.
@@ -49,9 +84,14 @@ pub(super) fn build_base_api_router(
             post(api::setup::save_database_config),
